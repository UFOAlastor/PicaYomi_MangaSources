{
  "settings": {
    "base_url": "https://api.example.invalid"
  },
  "responses": {
    "https://api.example.invalid/comics?page=1": {
      "status_code": 200,
      "body": "{\"items\": [{\"id\": \"book-a\", \"title\": \"Demo\", \"cover\": \"https://images.example.invalid/cover.jpg\"}], \"page\": 1, \"pages\": 1, \"total\": 1}"
    },
    "https://api.example.invalid/comics?page=2": {
      "status_code": 200,
      "body": "{broken"
    },
    "https://api.example.invalid/search?q=Demo&page=1": {
      "status_code": 200,
      "body": "{\"items\": [{\"id\": \"book-a\", \"title\": \"Demo\", \"cover\": \"https://images.example.invalid/cover.jpg\"}], \"page\": 1, \"pages\": 1, \"total\": 1}"
    },
    "https://api.example.invalid/search?q=Empty&page=1": {
      "status_code": 200,
      "body": "{\"items\": [], \"page\": 1, \"pages\": 1, \"total\": 0}"
    },
    "https://api.example.invalid/comic/book-a": {
      "status_code": 200,
      "body": "{\"id\": \"book-a\", \"title\": \"Demo\", \"cover\": \"https://images.example.invalid/cover.jpg\"}"
    },
    "https://api.example.invalid/comic/missing": {
      "status_code": 404,
      "body": "{\"message\": \"missing\"}"
    },
    "https://api.example.invalid/comic/book-a/chapters": {
      "status_code": 200,
      "body": "{\"items\": [{\"id\": \"chapter-a\", \"title\": \"Chapter A\"}]}"
    },
    "https://api.example.invalid/comic/book-a/chapter/chapter-a": {
      "status_code": 200,
      "body": "{\"images\": [\"https://images.example.invalid/page.jpg\"]}"
    }
  },
  "cases": [
    {
      "method": "getComics",
      "args": [
        1
      ],
      "expect": {
        "ok": true,
        "counts": {
          "comics": 1
        },
        "data": {
          "comics": [
            {
              "_id": "book-a",
              "title": "Demo"
            }
          ],
          "page": 1
        }
      }
    },
    {
      "method": "getLatest",
      "args": [
        1
      ],
      "expect": {
        "ok": true,
        "counts": {
          "comics": 1
        }
      }
    },
    {
      "method": "search",
      "args": [
        "Demo",
        1
      ],
      "expect": {
        "ok": true,
        "counts": {
          "comics": 1
        }
      }
    },
    {
      "method": "getComicDetail",
      "args": [
        "book-a"
      ],
      "expect": {
        "ok": true,
        "data": {
          "_id": "book-a",
          "title": "Demo"
        }
      }
    },
    {
      "method": "getChapters",
      "args": [
        "book-a"
      ],
      "expect": {
        "ok": true,
        "counts": {
          "episodes": 1
        },
        "data": {
          "episodes": [
            {
              "_id": "chapter-a",
              "order": "c_chapter-a",
              "sort_index": 1
            }
          ]
        }
      }
    },
    {
      "method": "getAllChapterImages",
      "args": [
        "book-a",
        "c_chapter-a"
      ],
      "expect": {
        "ok": true,
        "counts": {
          "images": 1
        }
      }
    },
    {
      "method": "getComicDetail",
      "args": [
        "missing"
      ],
      "expect": {
        "ok": false,
        "error": "HTTP 404"
      }
    },
    {
      "method": "getComics",
      "args": [
        2
      ],
      "expect": {
        "ok": false
      }
    },
    {
      "method": "search",
      "args": [
        "Empty",
        1
      ],
      "expect": {
        "ok": true,
        "counts": {
          "comics": 0
        }
      }
    },
    {
      "method": "search",
      "args": [
        "",
        1
      ],
      "expect": {
        "ok": false,
        "error": "请输入关键词"
      }
    }
  ]
}
